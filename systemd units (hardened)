# =============================================================================
# /etc/systemd/system/rabby-host.service — Next.js control panel
# Runs as the unprivileged 'rabby' user. No root. Reads secrets from
# /etc/rabby-host/rabbyby-host.env (root-owned, 0640, group-readable).
# =============================================================================
[Unit]
Description=Rabby Host control panel (Next.js)
After=network.target postgresql.service redis-server.service
Requires=postgresql.service
Wants=redis-server.service

[Service]
Type=simple
User=rabby
Group=rabby
EnvironmentFile=/etc/rabby-host/rabby-host.env
WorkingDirectory=/opt/rabby-host
ExecStart=/usr/bin/node /opt/rabby-host/node_modules/.bin/next start -p 3000 -H 127.0.0.1
Restart=on-failure
RestartSec=5

# --- Hardening (tested against the panel runtime) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/log/rabby-host /var/lib/rabby-host
ReadOnlyPaths=/opt/rabby-host
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

# Next.js requires some address space for JIT; keep the limit generous but bounded.
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target

# =============================================================================
# /etc/systemd/system/rabby-host-agent.service — privileged Python agent
# The ONLY component with elevated capabilities. Binds to 127.0.0.1 by default.
# ============================================================-===============
[Unit]
Description=Rabby Host privileged agent (FastAPI)
After=network.target

[Service]
Type=simple
User=rabby-agent
Group=rabby-agent
EnvironmentFile=/etc/rabby-host/rabby-host.env
WorkingDirectory=/opt/rabby-host/agent
ExecStart=/opt/rabby-host-agent-venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8417 --workers 2
Restart=on-failure
RestartSec=3

# --- Hardening ---
# The agent legitimately writes nginx/php configs and site directories, so
# ProtectSystem=full (not strict) and explicit ReadWritePaths are used.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/etc/nginx/sites-available /etc/nginx/sites-enabled /etc/php /var/www /var/log/rabby-host
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
# The agent may restart whitelisted services via a polkit rule; it does NOT
# need CAP_SYS_ADMIN or CAP_SYS_PTRACE.
CapabilityBoundingSet=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
AmbientCapabilities=CAP_DAC_OVERRIDE CAP_CHOWN CAP_FOWNER
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target

# =============================================================================
# /etc/systemd/system/rabby-host-worker.service — async task engine worker
# =============================================================================
[Unit]
Description=Rabby Host task engine worker
After=network.target postgresql.service redis-server.service rabby-host-agent.service
Requires=postgresql.service

[Service]
Type=simple
User=rabby
Group=rabby
EnvironmentFile=/etc/rabby-host/rabby-host.env
WorkingDirectory=/opt/rabby-host
ExecStart=/usr/bin/node /opt/rabby-host/scripts/worker.mjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM

# --- Hardening: workers perform file moves and archive extraction ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/rabby-host /var/www /var/log/rabby-host
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictNamespaces=true
RestrictRealtime=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
